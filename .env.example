# Copy this file to .env and fill in the values.
# .env is ignored by git so your secrets never reach GitHub.

# Domain pointing at this server's public IP (A record).
# Use "localhost" for a local-only instance.
SEARXNG_HOSTNAME=localhost

# Email used by Let's Encrypt for HTTPS certificates.
# Leave empty to use a local (self-signed) certificate, e.g. for localhost.
LETSENCRYPT_EMAIL=

# Secret key used by SearXNG. Generate it with: ./scripts/generate-secret.sh
SEARXNG_SECRET=
